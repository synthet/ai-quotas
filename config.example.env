# AI Quotas - full example configuration.
# Copy the lines you need into .env (git-ignored). Every value below is the default
# unless marked "example". Keys and tokens belong in .env only, never in this file.

# --- Which cards are polled -------------------------------------------------
# cli = Claude, Codex, Cursor, Antigravity (+ Claude API credits)
# api = OpenAI, Anthropic and Gemini API probes (+ Claude API credits)
# all = everything
QUOTA_SCOPE=cli

# Per-card switches. A card is polled when QUOTA_SCOPE includes it AND its switch is true.
ENABLE_CLAUDE_SUBSCRIPTION=true     # Claude          - `claude -p /usage`
ENABLE_ANTHROPIC_API_CREDITS=true   # Claude API credits - signed-in `ant` one-token probe
ENABLE_CHATGPT_CODEX=true           # Codex           - `codex app-server`
ENABLE_CURSOR=true                  # Cursor          - signed-in IDE session
ENABLE_ANTIGRAVITY=true             # Antigravity     - `agy -p /usage`
ENABLE_ANTHROPIC_API=true           # Claude API limits - needs ANTHROPIC_API_KEY, scope api/all
ENABLE_OPENAI_API=true              # OpenAI API      - needs OPENAI_API_KEY, scope api/all
ENABLE_GEMINI_API=true              # Gemini API      - needs GOOGLE_API_KEY, scope api/all
ENABLE_GEMINI_CLI=false             # Gemini CLI (legacy, not recommended; use Antigravity)

# Hide cards that returned no data (error, unauthorized, unavailable, skipped).
# The page header still shows how many are hidden; hover it for the reasons.
# /api/snapshot always returns every card.
HIDE_UNREACHABLE=true

# --- API keys (scope api/all) -----------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Probes -----------------------------------------------------------------
PROBE_ENABLED=true
PROBE_INTERVAL_SEC=300
OPENAI_PROBE_MODEL=gpt-4o-mini
ANTHROPIC_PROBE_MODEL=claude-haiku-4-5
GEMINI_PROBE_MODEL=gemini-3.8-flash

# --- CLI locations and timeouts (empty = auto-detect) -----------------------
CLAUDE_COMMAND=
CLAUDE_USAGE_TIMEOUT_SEC=90
ANT_COMMAND=
ANT_CREDIT_TIMEOUT_SEC=30
ANTIGRAVITY_COMMAND=
CURSOR_AUTH_PATH=
GEMINI_COMMAND=
GEMINI_CLI_TIMEOUT_SEC=45
GEMINI_CREDENTIALS_DIR=
GEMINI_CLI_USE_ENV_GCP_PROJECT=false
INCLUDE_GEMINI_CLI_COLLECTOR=false   # legacy alias for ENABLE_GEMINI_CLI=true
