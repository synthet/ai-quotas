# cli = Codex, Cursor, Claude, Antigravity (no API probes)
# api = OpenAI + Anthropic + Gemini API only
# all = everything
QUOTA_SCOPE=cli

# INCLUDE_GEMINI_CLI_COLLECTOR=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

PROBE_ENABLED=true
PROBE_INTERVAL_SEC=300

OPENAI_PROBE_MODEL=gpt-4o-mini
ANTHROPIC_PROBE_MODEL=claude-haiku-4-5
GEMINI_PROBE_MODEL=gemini-3.8-flash

# Optional overrides
# GEMINI_CREDENTIALS_DIR=
# CURSOR_AUTH_PATH=
